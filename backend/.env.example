# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=8000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + cookies)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Database — set DB_CLIENT to "sqlite3", "mysql2", or "pg".
# ------------------------------------------------------------------
DB_CLIENT=sqlite3

# Used only when DB_CLIENT=sqlite3 — zero-config, file-based, great for
# local dev. NOT recommended for production (no concurrent writers).
SQLITE_FILENAME=./data/dev.sqlite3

# Used only when DB_CLIENT=mysql2 or DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# ------------------------------------------------------------------
# Auth — local provider (bcrypt + JWT)
# ------------------------------------------------------------------
# Which provider handles login/register: "local" | "wordpress" | "wagtail"
AUTH_PROVIDER=local

# Long, random, unique strings in production — e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token

BCRYPT_SALT_ROUNDS=12

# How long a forgot-password reset link stays valid.
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ------------------------------------------------------------------
# Auth — WordPress provider (only used if AUTH_PROVIDER=wordpress)
# Requires the "JWT Authentication for WP REST API" plugin (or similar)
# installed on the WordPress site.
# ------------------------------------------------------------------
WORDPRESS_URL=https://your-wp-site.com
WORDPRESS_JWT_TOKEN_PATH=/wp-json/jwt-auth/v1/token
WORDPRESS_JWT_VALIDATE_PATH=/wp-json/jwt-auth/v1/token/validate
WORDPRESS_USER_ME_PATH=/wp-json/wp/v2/users/me

# ------------------------------------------------------------------
# Auth — Wagtail/Django provider (only used if AUTH_PROVIDER=wagtail)
# Assumes djangorestframework-simplejwt (or similar) exposes a token
# endpoint on the Wagtail/Django backend. Adjust paths to match your setup.
# ------------------------------------------------------------------
WAGTAIL_URL=https://your-wagtail-site.com
WAGTAIL_TOKEN_PATH=/api/auth/token/
WAGTAIL_TOKEN_REFRESH_PATH=/api/auth/token/refresh/
WAGTAIL_USER_ME_PATH=/api/auth/user/

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------
# Email — used for password reset and admin-created-user welcome emails
# (src/services/emailService.js). Defaults target Mailpit
# (https://mailpit.axllent.org/) running locally, no auth needed — view
# sent mail at http://localhost:8025. Point these at a real provider's
# SMTP credentials (Resend, Brevo, SES, ...) for production; no code
# changes needed.
# ------------------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Slokabase <no-reply@slokabase.local>"

# ------------------------------------------------------------------
# Seed accounts — only read by `npm run seed`, not the running app
# ------------------------------------------------------------------
# Overrides the default admin@example.com / ChangeMe123! seeded account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Overrides the default demo@example.com / DemoOnly123! seeded account —
# a read-only demo role (see db/seeds/00_roles_permissions.js's "demo"
# grants) intended for a public-facing deployment's login page to publish.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
