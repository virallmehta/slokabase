# ------------------------------------------------------------------
# Production reference template — NOT loaded automatically, not a
# substitute for .env. This documents what changes for a production
# deploy (informed by deploying to Vercel + Neon Postgres); copy the
# relevant values into wherever your host actually reads env vars
# from. See the per-var note below for Vercel specifically.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=8000
NODE_ENV=production
# The real production frontend origin — never localhost. Must be exact
# (scheme + host, no trailing slash) since it drives both CORS and the
# cookie settings auth relies on.
FRONTEND_URL=https://your-production-frontend-domain.com

# ------------------------------------------------------------------
# Database — production should be "mysql2" or "pg", never "sqlite3"
# (no concurrent writers, and the file doesn't persist on most hosts).
# ------------------------------------------------------------------
DB_CLIENT=pg

DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Managed Postgres providers (Neon, Supabase, RDS, ...) require TLS on
# their connection — the driver refuses to connect without this.
DB_SSL=true

# ------------------------------------------------------------------
# Auth — local provider (bcrypt + JWT)
# ------------------------------------------------------------------
AUTH_PROVIDER=local

# Generate fresh secrets for production — `openssl rand -hex 64` for
# each. Never reuse the values from your local .env: a leaked/shared
# local secret would let anyone forge production sessions.
JWT_ACCESS_SECRET=generate-a-new-production-secret
JWT_REFRESH_SECRET=generate-a-different-new-production-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token

BCRYPT_SALT_ROUNDS=12

PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ------------------------------------------------------------------
# Rate limiting — defaults from .env.example are usually fine as-is
# ------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------
# Email — point at your real provider's SMTP credentials (Resend,
# Brevo, SES, ...). No code changes needed, see src/services/emailService.js.
# ------------------------------------------------------------------
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="Your App <no-reply@yourdomain.com>"

# ------------------------------------------------------------------
# Vercel note: this file is documentation only — Vercel doesn't read
# .env files from the repo at runtime. Set every var above in the
# project's Settings > Environment Variables dashboard instead (scoped
# to the Production environment), not by committing real values here.
# ------------------------------------------------------------------
